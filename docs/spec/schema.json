{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pointgroup-tables:schema:1",
  "title": "pointgroup-tables table document",
  "description": "One document of the pointgroup-tables CLI: the tables for one point group under one set of options. See docs/spec/output-schema.md. The keys chain, subgroup_chain and the components of a matrices entry or a cg irrep record are present only under --chain (version 2); the cg table is the one table of the cg document (version 2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator",
    "group",
    "tables",
    "double",
    "values",
    "field",
    "basis_convention",
    "elements"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "pointgroup-tables" },
        "version": { "type": "string" }
      }
    },
    "group": { "$ref": "#/$defs/group" },
    "tables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["elements", "subgroup_chain", "cayley", "factor", "characters", "matrices", "cg"] }
    },
    "double": { "type": "boolean" },
    "irreps": { "enum": ["ordinary", "projective", "all"] },
    "values": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["exact", "numeric", "pretty"] }
    },
    "field": { "$ref": "#/$defs/field" },
    "label_convention": { "$ref": "#/$defs/convention" },
    "basis_convention": { "$ref": "#/$defs/convention" },
    "chain": { "$ref": "#/$defs/chain" },
    "elements": { "$ref": "#/$defs/elementsTable" },
    "subgroup_chain": { "$ref": "#/$defs/subgroupChainTable" },
    "cayley": { "$ref": "#/$defs/cayleyTable" },
    "factor": { "$ref": "#/$defs/factorTable" },
    "characters": { "$ref": "#/$defs/charactersTable" },
    "matrices": { "$ref": "#/$defs/matricesTable" },
    "cg": { "$ref": "#/$defs/cgTable" }
  },
  "dependentRequired": {
    "chain": ["subgroup_chain"],
    "subgroup_chain": ["chain"]
  },
  "allOf": [
    {
      "if": { "properties": { "tables": { "contains": { "const": "subgroup_chain" } } } },
      "then": { "required": ["subgroup_chain", "chain"] }
    },
    {
      "if": { "properties": { "tables": { "contains": { "const": "cayley" } } } },
      "then": { "required": ["cayley"] }
    },
    {
      "if": { "properties": { "tables": { "contains": { "const": "factor" } } } },
      "then": { "required": ["factor"] }
    },
    {
      "if": { "properties": { "tables": { "contains": { "const": "characters" } } } },
      "then": { "required": ["characters", "irreps"] }
    },
    {
      "if": { "properties": { "tables": { "contains": { "const": "matrices" } } } },
      "then": { "required": ["matrices", "irreps"] }
    },
    {
      "if": { "properties": { "tables": { "contains": { "const": "cg" } } } },
      "then": { "required": ["cg", "irreps"] }
    },
    {
      "if": { "required": ["cg"] },
      "then": {
        "properties": { "tables": { "not": { "contains": { "enum": ["cayley", "factor", "characters", "matrices"] } } } },
        "not": { "required": ["double"], "properties": { "double": { "const": true } } }
      }
    },
    {
      "if": { "required": ["chain"] },
      "then": {
        "properties": {
          "tables": { "contains": { "const": "subgroup_chain" } },
          "matrices": { "properties": { "irreps": { "items": { "required": ["components"] } } } },
          "cg": { "properties": { "irreps": { "items": { "required": ["components"] } } } }
        }
      },
      "else": {
        "properties": {
          "matrices": { "properties": { "irreps": { "items": { "not": { "required": ["components"] } } } } },
          "cg": { "properties": { "irreps": { "items": { "not": { "required": ["components"] } } } } }
        }
      }
    }
  ],
  "$defs": {
    "index": { "type": "integer", "minimum": 0 },
    "sign": { "enum": [1, -1] },
    "groupSymbol": { "type": "string", "pattern": "^(C[1-9][0-9]*[vh]?|S([2468]|[1-9][0-9]*[02468])|D[1-9][0-9]*[hd]?|T[dh]?|Oh?|Ih?)$" },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "input_symbol", "family", "order", "type", "rotation_group"],
      "properties": {
        "symbol": { "$ref": "#/$defs/groupSymbol" },
        "input_symbol": { "type": "string" },
        "family": { "enum": ["Cn", "Cnv", "Cnh", "S2n", "Dn", "Dnh", "Dnd", "T", "Td", "Th", "O", "Oh", "I", "Ih"] },
        "n": { "type": "integer", "minimum": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["proper", "centro", "twisted"] },
        "rotation_group": { "type": "string", "pattern": "^([CD][1-9][0-9]*|T|O|I)$" }
      }
    },
    "subgroupGroup": {
      "description": "The group record of a step of the chain: the group record without input_symbol.",
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "family", "order", "type", "rotation_group"],
      "properties": {
        "symbol": { "$ref": "#/$defs/groupSymbol" },
        "family": { "enum": ["Cn", "Cnv", "Cnh", "S2n", "Dn", "Dnh", "Dnd", "T", "Td", "Th", "O", "Oh", "I", "Ih"] },
        "n": { "type": "integer", "minimum": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["proper", "centro", "twisted"] },
        "rotation_group": { "type": "string", "pattern": "^([CD][1-9][0-9]*|T|O|I)$" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "conductor", "degree", "generator", "basis"],
      "properties": {
        "kind": { "const": "cyclotomic" },
        "conductor": { "type": "integer", "minimum": 1 },
        "degree": { "type": "integer", "minimum": 1 },
        "generator": { "type": "string", "pattern": "^exp\\(2\\*pi\\*i/[1-9][0-9]*\\)$" },
        "basis": { "const": "power" }
      }
    },
    "convention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "coverage": { "enum": ["reference", "extrapolated"] }
      }
    },
    "chain": {
      "description": "The chain metadata of a --chain document: the option value as typed, the canonical spelling of the resolved chain (empty for the empty chain) and the normalised symbols, G first. See docs/spec/group-chains.md#metadata.",
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "canonical", "symbols"],
      "properties": {
        "input": { "type": "string", "minLength": 1 },
        "canonical": { "type": "string" },
        "symbols": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/groupSymbol" } }
      }
    },
    "exactValue": {
      "description": "Coefficient vector over the power basis of the document field: phi(M) pairs [numerator, denominator].",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "prefixItems": [{ "type": "integer" }, { "type": "integer", "minimum": 1 }],
        "items": false,
        "minItems": 2
      }
    },
    "numericValue": {
      "description": "Correctly rounded double-precision approximation [re, im].",
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 2
    },
    "prettyValue": { "type": "string" },
    "exactMatrix": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/exactValue" } }
    },
    "numericMatrix": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/numericValue" } }
    },
    "prettyMatrix": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/prettyValue" } }
    },
    "elementLabel": {
      "type": "string",
      "pattern": "^~?(E|i|C2|C2\\([1-9][0-9]*\\)|C2''?\\([1-9][0-9]*\\)|C[1-9][0-9]*\\^-?[1-9][0-9]*(\\([1-9][0-9]*\\))?|S[1-9][0-9]*\\^-?[1-9][0-9]*(\\([1-9][0-9]*\\))?|sigma_h(\\([1-9][0-9]*\\))?|sigma_[vd]\\([1-9][0-9]*\\)|sigma\\([1-9][0-9]*\\))$"
    },
    "classLabel": {
      "type": "string",
      "pattern": "^(\\d*~?(E|i|C2''?|[CS]\\d+(\\^-?\\d+)?|sigma(_[hvd])?))(\\+\\d*~(E|i|C2''?|[CS]\\d+(\\^-?\\d+)?|sigma(_[hvd])?))?$"
    },
    "irrepSymbol": {
      "type": "string",
      "pattern": "^[12]?[ABETGHI](\\d+|\\d*[13579]/2)?(g|u|'|'')?$"
    },
    "elementRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "label", "parity", "kind", "order", "inverse", "class"],
      "properties": {
        "index": { "$ref": "#/$defs/index" },
        "label": { "$ref": "#/$defs/elementLabel" },
        "reference_label": { "type": "string" },
        "parity": { "$ref": "#/$defs/sign" },
        "kind": { "enum": ["identity", "rotation", "inversion", "reflection", "rotoreflection"] },
        "order": { "type": "integer", "minimum": 1 },
        "power": { "type": "integer" },
        "axis_class": { "enum": ["principal", "secondary", "secondary_double_prime", "polyhedral"] },
        "axis_index": { "type": "integer", "minimum": 1 },
        "inverse": { "$ref": "#/$defs/index" },
        "class": { "$ref": "#/$defs/index" },
        "barred": { "type": "boolean" },
        "base_index": { "$ref": "#/$defs/index" }
      },
      "dependentRequired": { "barred": ["base_index"], "base_index": ["barred"] }
    },
    "classRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "label", "size", "representative", "members", "inverse"],
      "properties": {
        "index": { "$ref": "#/$defs/index" },
        "label": { "$ref": "#/$defs/classLabel" },
        "reference_label": { "type": "string" },
        "size": { "type": "integer", "minimum": 1 },
        "representative": { "$ref": "#/$defs/index" },
        "members": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/index" } },
        "inverse": { "$ref": "#/$defs/index" },
        "regular": { "type": "boolean" },
        "base_class": { "$ref": "#/$defs/index" },
        "split": { "type": "boolean" },
        "barred": { "type": "boolean" }
      },
      "dependentRequired": { "base_class": ["split"], "split": ["base_class"], "barred": ["split"] }
    },
    "irrepRecord": {
      "type": "object",
      "required": ["index", "symbol", "dimension", "projective", "letter", "frobenius_schur"],
      "properties": {
        "index": { "$ref": "#/$defs/index" },
        "symbol": { "$ref": "#/$defs/irrepSymbol" },
        "reference_symbol": { "type": "string" },
        "bethe": { "type": "string", "pattern": "^Gamma[1-9][0-9]*[+-]?$" },
        "dimension": { "type": "integer", "minimum": 1 },
        "projective": { "type": "boolean" },
        "letter": { "enum": ["A", "B", "E", "T", "G", "H", "I"] },
        "component": { "enum": [1, 2] },
        "partner": { "$ref": "#/$defs/index" },
        "subscript": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string", "pattern": "^[0-9]*[13579]/2$" }
          ]
        },
        "suffix": { "enum": ["g", "u", "'", "''"] },
        "frobenius_schur": { "enum": [1, 0, -1] }
      },
      "dependentRequired": { "component": ["partner"], "partner": ["component"] }
    },
    "irrepHeader": {
      "allOf": [{ "$ref": "#/$defs/irrepRecord" }],
      "unevaluatedProperties": false
    },
    "componentRecord": {
      "description": "One component of an irrep in a chain-adapted basis: its position and its chain label, as irrep indices into the subgroup records' irreps (labels[j] indexes subgroup_chain.items[j].irreps) and as the canonical symbols of those irreps. Both arrays have one entry per step, none under the empty chain.",
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "labels", "symbols"],
      "properties": {
        "index": { "$ref": "#/$defs/index" },
        "labels": { "type": "array", "items": { "$ref": "#/$defs/index" } },
        "symbols": { "type": "array", "items": { "$ref": "#/$defs/irrepSymbol" } }
      }
    },
    "irrepMatrices": {
      "description": "An irrep record carrying its matrices, one per element of G in canonical order, and under --chain the component records of the chain-adapted basis.",
      "allOf": [{ "$ref": "#/$defs/irrepRecord" }],
      "properties": {
        "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/componentRecord" } },
        "exact": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/exactMatrix" } },
        "numeric": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/numericMatrix" } },
        "pretty": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/prettyMatrix" } }
      },
      "unevaluatedProperties": false
    },
    "doubleCosetRecord": {
      "description": "One double coset H g H of a step: its representative (smallest G index), its size, and the ascending indices into the cosets array of the left cosets it is the union of.",
      "type": "object",
      "additionalProperties": false,
      "required": ["representative", "size", "cosets"],
      "properties": {
        "representative": { "$ref": "#/$defs/index" },
        "size": { "type": "integer", "minimum": 1 },
        "cosets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/index" } }
      }
    },
    "subgroupRecord": {
      "description": "One step of the chain: its abstract group, its embedding (G-double indices of the images of the lifted preimages of its canonical element list), the left cosets and double cosets of the step in the previous group (G element indices), its full irrep list and the branching rule from the previous group's irreps.",
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "embedding", "cosets", "double_cosets", "irreps", "branching"],
      "properties": {
        "group": { "$ref": "#/$defs/subgroupGroup" },
        "embedding": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/index" } },
        "cosets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/index" } }
        },
        "double_cosets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/doubleCosetRecord" } },
        "irreps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/irrepHeader" } },
        "branching": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/index" } }
        }
      }
    },
    "subgroupChainTable": {
      "description": "The resolved chain of a --chain document: the full irrep list of G and one subgroup record per step in chain order (none for the empty chain). Depends on the group and the chain only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["irreps", "items"],
      "properties": {
        "irreps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/irrepHeader" } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/subgroupRecord" } }
      }
    },
    "elementsTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "items", "classes"],
      "properties": {
        "group": { "enum": ["G", "G_double"] },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/elementRecord" } },
        "classes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/classRecord" } }
      }
    },
    "cayleyTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "table"],
      "properties": {
        "group": { "enum": ["G", "G_double"] },
        "table": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/index" } }
        }
      }
    },
    "factorTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "table"],
      "properties": {
        "group": { "const": "G" },
        "table": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sign" } }
        }
      }
    },
    "charactersTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_group", "irreps", "classes"],
      "properties": {
        "class_group": { "enum": ["G", "G_double"] },
        "irreps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/irrepHeader" } },
        "classes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/classRecord" } },
        "exact": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/exactValue" } } },
        "numeric": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/numericValue" } } },
        "pretty": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/prettyValue" } } }
      },
      "anyOf": [{ "required": ["exact"] }, { "required": ["numeric"] }, { "required": ["pretty"] }]
    },
    "matricesTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["irreps"],
      "properties": {
        "irreps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/irrepMatrices" } }
      }
    },
    "irrepWithComponents": {
      "description": "An irrep record of the cg table: the irrep record, and under --chain the component records of the chain-adapted basis.",
      "allOf": [{ "$ref": "#/$defs/irrepRecord" }],
      "properties": {
        "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/componentRecord" } }
      },
      "unevaluatedProperties": false
    },
    "constituentRecord": {
      "description": "One irrep gamma with coupling multiplicity n > 0 in the direct product of a pair: its global index, n, and [first, count] of its columns in the coupling matrix (count = n * dimension of gamma).",
      "type": "object",
      "additionalProperties": false,
      "required": ["irrep", "multiplicity", "columns"],
      "properties": {
        "irrep": { "$ref": "#/$defs/index" },
        "multiplicity": { "type": "integer", "minimum": 1 },
        "columns": { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "$ref": "#/$defs/index" }, { "type": "integer", "minimum": 1 }] }
      }
    },
    "columnRecord": {
      "description": "One column of a coupling matrix: its position, the constituent irrep, the coupled copy, the component, and for a pair of equal factors the exchange sign of the copy.",
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "irrep", "copy", "component"],
      "properties": {
        "index": { "$ref": "#/$defs/index" },
        "irrep": { "$ref": "#/$defs/index" },
        "copy": { "$ref": "#/$defs/index" },
        "component": { "$ref": "#/$defs/index" },
        "exchange": { "$ref": "#/$defs/sign" }
      }
    },
    "pairRecord": {
      "description": "The Clebsch-Gordan coefficients of one unordered pair of irreps (alpha <= beta, global indices): the coupling matrix of order dimension = d_alpha * d_beta, rows the product basis in row-major order, columns described by the column records, in each requested value form.",
      "type": "object",
      "additionalProperties": false,
      "required": ["irreps", "dimension", "constituents", "columns"],
      "properties": {
        "irreps": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/index" } },
        "dimension": { "type": "integer", "minimum": 1 },
        "constituents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/constituentRecord" } },
        "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/columnRecord" } },
        "exact": { "$ref": "#/$defs/exactMatrix" },
        "numeric": { "$ref": "#/$defs/numericMatrix" },
        "pretty": { "$ref": "#/$defs/prettyMatrix" }
      },
      "anyOf": [{ "required": ["exact"] }, { "required": ["numeric"] }, { "required": ["pretty"] }]
    },
    "cgTable": {
      "description": "The Clebsch-Gordan table of a cg document: the full irrep list of G (never filtered by --irreps) and one pair record per unordered pair of the --irreps selection, in lexicographic order of the two indices.",
      "type": "object",
      "additionalProperties": false,
      "required": ["irreps", "pairs"],
      "properties": {
        "irreps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/irrepWithComponents" } },
        "pairs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pairRecord" } }
      }
    }
  }
}
